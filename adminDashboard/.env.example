# PassKru Admin Dashboard — Environment Variables
# Copy this file to .env and fill in your values.

# Clerk Authentication Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Main User Client Application URL (For switching back to User Dashboard / logging out)
# In production, set this to your hosted client URL (e.g. https://passkru.com or https://passkru.vercel.app)
VITE_CLIENT_URL=http://localhost:3000

# Backend API base URL
VITE_API_URL=http://localhost:5000/api

# No Supabase keys here: file uploads go through the API (POST /api/uploads/sign),
# which signs them with the server-only service role key.
