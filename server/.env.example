NODE_ENV=development
PORT=5000

# Database (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Auth — long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
# Changing it signs every user out (all existing tokens stop verifying).
JWT_SECRET=

# CORS / redirects
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback


# SMTP for OTP emails. Unset = codes are printed to the server console (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PassKru App" <noreply@your-verified-domain.com>

# Supabase Storage — lets the API hand out short-lived signed links so the
# `papers` bucket can be private. Service role key is SERVER-ONLY: never put it
# in a VITE_* / frontend variable.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Bucket names for admin uploads (POST /api/uploads/sign). Defaults shown.
# SUPABASE_PAPERS_BUCKET=papers
# SUPABASE_ANNOUNCEMENT_BUCKET=announcement

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

APP_UTC_OFFSET_MINUTES=420
